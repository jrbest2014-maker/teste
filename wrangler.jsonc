{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "v-one-cloud-inference-r1",
  "main": "src/cloudflare/vone_cloud_worker.ts",
  "compatibility_date": "2026-09-26",
  "ai": { "binding": "AI" },
  "services": [{ "binding": "VONE_MASTER", "service": "vone-control-plane" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
