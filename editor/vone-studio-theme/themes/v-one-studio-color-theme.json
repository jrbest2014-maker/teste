{
  "name": "V-ONE Studio",
  "type": "dark",
  "colors": {
    "focusBorder": "#F2B134",
    "foreground": "#E8E6E3",
    "selection.background": "#F2B13455",

    "editor.background": "#121212",
    "editor.foreground": "#E8E6E3",
    "editor.lineHighlightBackground": "#1C1C1C",
    "editor.selectionBackground": "#F2B13433",
    "editorCursor.foreground": "#F2B134",
    "editorLineNumber.foreground": "#5A5A5A",
    "editorLineNumber.activeForeground": "#F2B134",
    "editorWhitespace.foreground": "#2A2A2A",
    "editorIndentGuide.background": "#242424",
    "editorIndentGuide.activeBackground": "#3A3A3A",

    "activityBar.background": "#0E0E0E",
    "activityBar.foreground": "#E8E6E3",
    "activityBar.inactiveForeground": "#6B6B6B",
    "activityBarBadge.background": "#F2B134",
    "activityBarBadge.foreground": "#121212",

    "sideBar.background": "#161616",
    "sideBar.foreground": "#CFCDC9",
    "sideBarTitle.foreground": "#E8E6E3",
    "sideBarSectionHeader.background": "#1C1C1C",

    "statusBar.background": "#0E0E0E",
    "statusBar.foreground": "#CFCDC9",
    "statusBar.noFolderBackground": "#0E0E0E",
    "statusBar.debuggingBackground": "#F2B134",
    "statusBar.debuggingForeground": "#121212",

    "titleBar.activeBackground": "#0E0E0E",
    "titleBar.activeForeground": "#E8E6E3",
    "titleBar.inactiveBackground": "#0E0E0E",
    "titleBar.inactiveForeground": "#6B6B6B",

    "tab.activeBackground": "#1C1C1C",
    "tab.activeForeground": "#F2B134",
    "tab.inactiveBackground": "#141414",
    "tab.inactiveForeground": "#8A8A8A",
    "tab.activeBorderTop": "#F2B134",

    "button.background": "#F2B134",
    "button.foreground": "#121212",
    "button.hoverBackground": "#FFC75A",

    "badge.background": "#F2B134",
    "badge.foreground": "#121212",

    "terminal.background": "#121212",
    "terminal.foreground": "#E8E6E3",
    "terminal.ansiYellow": "#F2B134",
    "terminal.ansiBrightYellow": "#FFC75A",
    "terminal.ansiGreen": "#3DDC97",
    "terminal.ansiBrightGreen": "#5DEFB0",
    "terminal.ansiRed": "#E5534B",
    "terminal.ansiBrightRed": "#FF6B61",

    "list.activeSelectionBackground": "#F2B13422",
    "list.activeSelectionForeground": "#F2B134",
    "list.inactiveSelectionBackground": "#1C1C1C",
    "list.hoverBackground": "#1A1A1A"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#E8E6E3"
      }
    },
    {
      "scope": "comment",
      "settings": {
        "foreground": "#6B6B6B",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#F2B134"
      }
    },
    {
      "scope": ["string", "string.quoted"],
      "settings": {
        "foreground": "#3DDC97"
      }
    },
    {
      "scope": ["constant.numeric", "constant.language"],
      "settings": {
        "foreground": "#FFC75A"
      }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": {
        "foreground": "#9FD3F2"
      }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type"],
      "settings": {
        "foreground": "#D9A6F2"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#E8E6E3"
      }
    }
  ]
}
