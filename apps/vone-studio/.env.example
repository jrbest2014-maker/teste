# Copie para .env.local e preencha pra sair do modo mock. Sem nenhuma
# variável definida, o app roda 100% em mock.

# --- Opção 1 (recomendada): worker local nesta máquina ---
# Não depende do Master na nuvem nem do D1 dele - continua respondendo
# mesmo se o Master cair (já aconteceu: cota de escrita do D1 excedida).
# Suba `npm run dev` do worker próprio (src/server/vone_owned_worker_main.ts)
# e copie host/porta/token do log de boot dele
# (bloco "local_chat_server" do JSON impresso ao subir).
VITE_VONE_LOCAL_URL=http://127.0.0.1:8787
VITE_VONE_LOCAL_TOKEN=cole-aqui-o-auth_token-do-log-de-boot

# --- Opção 2: Master na nuvem (fora deste repositório - ver AGENTS.md,
# seção "O Master"). Só usada se as duas VITE_VONE_LOCAL_* acima estiverem
# vazias. listSessions()/sendMessage() usam esta URL. ---
VITE_VONE_MASTER_URL=https://vone-control-plane.vone-technology.workers.dev

# O Cloud Inference Worker deste repositório
# (src/cloudflare/vone_cloud_worker.ts). getGateStatus() usa esta URL -
# contrato 100% confirmado, tem teste em vone_cloud_worker.test.ts.
VITE_VONE_CLOUD_WORKER_URL=https://v-one-cloud-inference-r1.vone-technology.workers.dev
