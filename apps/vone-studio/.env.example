# Copie para .env.local e preencha pra sair do modo mock e falar com o
# backend real. Nenhuma das duas é credencial - são só URLs públicas dos
# Workers. Sem nenhuma das duas definidas, o app roda 100% em mock.

# O Master (fora deste repositório - ver AGENTS.md, seção "O Master").
# listSessions()/sendMessage() usam esta URL.
VITE_VONE_MASTER_URL=https://vone-control-plane.vone-technology.workers.dev

# O Cloud Inference Worker deste repositório
# (src/cloudflare/vone_cloud_worker.ts). getGateStatus() usa esta URL -
# contrato 100% confirmado, tem teste em vone_cloud_worker.test.ts.
VITE_VONE_CLOUD_WORKER_URL=https://v-one-cloud-inference-r1.vone-technology.workers.dev
